{
  "expo": {
    "name": "meco wallet",
    "slug": "meco_wallet",
    "version": "1.25.0",
    "scheme": "meco-wallet",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/eb1f71ac-516e-4edd-b2a2-2914dad79f93"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meco.wallet",
      "buildNumber": "25"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.meco.wallet",
      "versionCode": 25,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "USE_BIOMETRIC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "owner": "monycoin",
    "extra": {
      "eas": {
        "projectId": "eb1f71ac-516e-4edd-b2a2-2914dad79f93"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
